---
import AdminShell from '../../layouts/AdminShell.astro';
import Appearance from '../../islands/Appearance';
import { requirePage } from '../../lib/session';

const session = await requirePage(Astro, { adminOnly: true });
if (session instanceof Response) return session;
---

<AdminShell
  title="Apparence"
  user={session.user}
  description="Thème du site public : le thème de base définit les tokens, les thèmes enfants ne surchargent que ce qu'ils changent."
>
  <Appearance client:only="preact" />
</AdminShell>
