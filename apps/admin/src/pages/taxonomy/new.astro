---
import AdminShell from '../../layouts/AdminShell.astro';
import { crumbs } from '../../lib/routes';
import VocabCreateForm from '../../islands/VocabCreateForm';
import { requirePage } from '../../lib/session';

const session = await requirePage(Astro, { writeOnly: true });
if (session instanceof Response) return session;
---

<AdminShell
  title="Nouveau vocabulaire"
  user={session.user}
  breadcrumb={[crumbs.taxonomy]}
>
  <VocabCreateForm client:only="preact" />
</AdminShell>
