---
import AdminShell from '../../../layouts/AdminShell.astro';
import { crumbs, routes } from '../../../lib/routes';
import TermCreateForm from '../../../islands/TermCreateForm';
import { requirePage } from '../../../lib/session';

const session = await requirePage(Astro, { writeOnly: true });
if (session instanceof Response) return session;

const { vid } = Astro.params;
if (vid === undefined) return Astro.redirect(routes.taxonomy.list);
---

<AdminShell
  title="Nouveau terme"
  user={session.user}
  chip={vid}
  breadcrumb={[crumbs.taxonomy]}
>
  <TermCreateForm client:only="preact" vid={vid} />
</AdminShell>
