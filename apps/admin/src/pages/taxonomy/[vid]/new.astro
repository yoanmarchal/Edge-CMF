---
import AdminShell from '../../../layouts/AdminShell.astro';
import TermCreateForm from '../../../islands/TermCreateForm';
import { getSessionUser, canWrite } from '../../../lib/session';

const session = await getSessionUser(Astro.cookies);
if (session === null) return Astro.redirect('/');
if (!canWrite(session.user)) return Astro.redirect('/?error=droits');

const { vid } = Astro.params;
if (vid === undefined) return Astro.redirect('/taxonomy');
---

<AdminShell
  title="Nouveau terme"
  user={session.user}
  chip={vid}
  breadcrumb={[{ label: 'Taxonomie', href: '/taxonomy' }]}
>
  <TermCreateForm client:only="preact" vid={vid} />
</AdminShell>
