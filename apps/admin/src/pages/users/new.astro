---
import AdminShell from '../../layouts/AdminShell.astro';
import { crumbs } from '../../lib/routes';
import UserCreateForm from '../../islands/UserCreateForm';
import { requirePage } from '../../lib/session';

const session = await requirePage(Astro, { adminOnly: true });
if (session instanceof Response) return session;
---

<AdminShell
  title="Nouvel utilisateur"
  user={session.user}
  breadcrumb={[crumbs.users]}
>
  <UserCreateForm client:only="preact" />
</AdminShell>
