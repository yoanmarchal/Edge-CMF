---
import AdminShell from '../../../layouts/AdminShell.astro';
import { crumbs, routes } from '../../../lib/routes';
import ContentForm from '../../../islands/ContentForm';
import { requirePage } from '../../../lib/session';

const session = await requirePage(Astro, { writeOnly: true });
if (session instanceof Response) return session;

const { id } = Astro.params;
if (id === undefined) return Astro.redirect(routes.content.list);
---

<AdminShell
  title="Éditer un contenu"
  user={session.user}
  breadcrumb={[crumbs.content]}
>
  <ContentForm client:only="preact" mode="edit" nodeId={id} />
</AdminShell>
