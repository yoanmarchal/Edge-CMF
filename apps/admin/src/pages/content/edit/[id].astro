---
import AdminShell from '../../../layouts/AdminShell.astro';
import ContentForm from '../../../islands/ContentForm';
import { getSessionUser, canWrite } from '../../../lib/session';

const env = Astro.locals.runtime.env;
const session = await getSessionUser(Astro.cookies, env);
if (session === null || !canWrite(session.user)) return Astro.redirect('/');

const { id } = Astro.params;
if (id === undefined) return Astro.redirect('/content');
---

<AdminShell title="Éditer un contenu — CMF Edge Admin" user={session.user}>
  <ContentForm client:only="preact" mode="edit" nodeId={id} />
</AdminShell>
