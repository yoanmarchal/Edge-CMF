---
import AdminShell from '../../layouts/AdminShell.astro';
import ContentList from '../../islands/ContentList';
import { requirePage, canWrite } from '../../lib/session';

const session = await requirePage(Astro);
if (session instanceof Response) return session;
---

<AdminShell title="Contenu" user={session.user}>
  <ContentList client:only="preact" canWrite={canWrite(session.user)} />
</AdminShell>
