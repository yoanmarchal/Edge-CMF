---
import AdminShell from '../../layouts/AdminShell.astro';
import ContentList from '../../islands/ContentList';
import { getSessionUser, canWrite } from '../../lib/session';

const session = await getSessionUser(Astro.cookies);
if (session === null) return Astro.redirect('/');
---

<AdminShell title="Contenu — CMF Edge Admin" user={session.user}>
  <ContentList client:only="preact" canWrite={canWrite(session.user)} />
</AdminShell>
