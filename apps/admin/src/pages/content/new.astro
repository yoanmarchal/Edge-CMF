---
import AdminShell from '../../layouts/AdminShell.astro';
import ContentForm from '../../islands/ContentForm';
import { getSessionUser, canWrite } from '../../lib/session';

const session = await getSessionUser(Astro.cookies);
if (session === null || !canWrite(session.user)) return Astro.redirect('/');

const typeId = Astro.url.searchParams.get('type') ?? 'page';
---

<AdminShell
  title="Nouveau contenu"
  user={session.user}
  breadcrumb={[{ label: 'Contenu', href: '/content' }]}
>
  <ContentForm client:only="preact" mode="new" typeId={typeId} />
</AdminShell>
