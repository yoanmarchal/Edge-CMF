---
import AdminShell from '../../layouts/AdminShell.astro';
import { crumbs } from '../../lib/routes';
import ContentForm from '../../islands/ContentForm';
import { requirePage } from '../../lib/session';

const session = await requirePage(Astro, { writeOnly: true });
if (session instanceof Response) return session;

const typeId = Astro.url.searchParams.get('type') ?? 'page';
---

<AdminShell
  title="Nouveau contenu"
  user={session.user}
  breadcrumb={[crumbs.content]}
>
  <ContentForm client:only="preact" mode="new" typeId={typeId} />
</AdminShell>
