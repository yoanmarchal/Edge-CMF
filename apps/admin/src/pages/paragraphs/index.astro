---
import AdminShell from '../../layouts/AdminShell.astro';
import TypesList from '../../islands/TypesList';
import { getSessionUser } from '../../lib/session';

const session = await getSessionUser(Astro.cookies);
if (session === null) return Astro.redirect('/');
if (session.user.role !== 'admin') return Astro.redirect('/?error=droits');
---

<AdminShell
  title="Types de paragraphes"
  user={session.user}
  description="Composants structurés réutilisables dans tous les contenus (équivalent Paragraphs de Drupal). Chaque type défini ici apparaît comme bloc ajoutable dans l'éditeur."
>
  <TypesList client:only="preact" kind="paragraph" />
</AdminShell>
