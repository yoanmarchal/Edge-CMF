---
import AdminShell from '../../layouts/AdminShell.astro';
import { crumbs } from '../../lib/routes';
import TypeCreateForm from '../../islands/TypeCreateForm';
import { requirePage } from '../../lib/session';

const session = await requirePage(Astro, { adminOnly: true });
if (session instanceof Response) return session;
---

<AdminShell
  title="Nouveau type de contenu"
  user={session.user}
  breadcrumb={[crumbs.types]}
>
  <TypeCreateForm client:only="preact" kind="node" />
</AdminShell>
