---
import AdminShell from '../../layouts/AdminShell.astro';
import TypeCreateForm from '../../islands/TypeCreateForm';
import { getSessionUser } from '../../lib/session';

const session = await getSessionUser(Astro.cookies);
if (session === null) return Astro.redirect('/');
if (session.user.role !== 'admin') return Astro.redirect('/?error=droits');
---

<AdminShell
  title="Nouveau type de contenu"
  user={session.user}
  breadcrumb={[{ label: 'Types de contenu', href: '/types' }]}
>
  <TypeCreateForm client:only="preact" kind="node" />
</AdminShell>
