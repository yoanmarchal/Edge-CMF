---
import AdminShell from '../../layouts/AdminShell.astro';
import TypesList from '../../islands/TypesList';
import { requirePage } from '../../lib/session';

const session = await requirePage(Astro, { adminOnly: true });
if (session instanceof Response) return session;
---

<AdminShell
  title="Types de contenu"
  user={session.user}
  description="Les bundles de nœuds (pages, articles…). Les composants réutilisables sont dans Paragraphes."
>
  <TypesList client:only="preact" kind="node" />
</AdminShell>
