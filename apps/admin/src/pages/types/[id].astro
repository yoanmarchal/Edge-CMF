---
import AdminShell from '../../layouts/AdminShell.astro';
import TypeDetail from '../../islands/TypeDetail';
import { getSessionUser } from '../../lib/session';

const session = await getSessionUser(Astro.cookies);
if (session === null) return Astro.redirect('/');
if (session.user.role !== 'admin') return Astro.redirect('/?error=droits');

const { id } = Astro.params;
if (id === undefined || !/^[a-z][a-z0-9_]*$/.test(id)) return Astro.redirect('/types');
---

{/* Pas de fil d'Ariane ici : la section parente (/types ou /paragraphs)
    dépend du `kind` du bundle, que seule l'îlot connaît une fois chargé.
    C'est le seul écran qui garde un lien retour côté client. */}
<AdminShell title={id} user={session.user}>
  <TypeDetail client:only="preact" id={id} />
</AdminShell>
