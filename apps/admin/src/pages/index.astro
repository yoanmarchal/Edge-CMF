---
import Login from '../layouts/Login.astro';
import AdminShell from '../layouts/AdminShell.astro';
import Flash from '../components/Flash.astro';
import Dashboard from '../islands/Dashboard';
import { Button } from '../islands/lib/ui';
import { getSessionUser } from '../lib/session';
import { LogIn } from 'lucide-preact';

const session = await getSessionUser(Astro.cookies);
---

{session === null ? (
  <Login title="Connexion — CMF Edge Admin">
    <h1>Administration</h1>
    {/* Même mécanisme que dans AdminShell : les échecs de connexion arrivent
        en `?error=identifiants|validation` depuis /api/login. */}
    <Flash />
    <form method="post" action="/api/login" class="stack">
      <label class="field">
        Email
        <input name="email" type="email" required />
      </label>
      <label class="field">
        Mot de passe
        <input name="password" type="password" minlength="8" required />
      </label>
      <Button type="submit" variant="primary" icon={LogIn}>Se connecter</Button>
    </form>
  </Login>
) : (
  <AdminShell title="Tableau de bord" user={session.user}>
    <Dashboard client:only="preact" />
  </AdminShell>
)}
