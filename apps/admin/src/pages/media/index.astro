---
import AdminShell from '../../layouts/AdminShell.astro';
import MediaLibrary from '../../islands/MediaLibrary';
import { requirePage, canWrite } from '../../lib/session';

const session = await requirePage(Astro);
if (session instanceof Response) return session;
---

<AdminShell
  title="Médias"
  user={session.user}
  description="Fichiers stockés sur R2 et servis par le front sous /media/…. « Copier l'URL » colle le chemin public à utiliser dans les contenus."
>
  <MediaLibrary client:only="preact" canWrite={canWrite(session.user)} />
</AdminShell>
