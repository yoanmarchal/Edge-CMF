---
import '../styles/admin.css';

// Page de connexion, pré-authentification : pas de garde de session à
// afficher (l'utilisateur n'est justement pas encore identifié), mais on
// reste dans le design system admin (full-size, pas le thème du front).
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- reset.css doit être le tout premier stylesheet chargé : c'est lui qui
         fixe l'ordre des cascade layers (reset, admin) en tête de fichier.
         Voir public/reset.css pour l'explication complète. -->
    <link rel="stylesheet" href="/reset.css" />
  </head>
  <body class="admin">
    <main class="admin-main login-page">
      <slot />
    </main>
    <style is:global>
      @layer admin {
        .login-page {
          max-width: 24rem;
          margin: 4rem auto;
        }
      }
    </style>
  </body>
</html>
