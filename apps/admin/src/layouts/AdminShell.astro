---
import '../styles/admin.css';
import type { UserContext } from '@edge-cmf/shared-types';
// Icônes SSR uniquement : rendues en SVG statique côté serveur (pas de
// directive client), donc zéro JS envoyé au navigateur pour la nav.
import {
  LayoutDashboard,
  FileText,
  Image,
  Shapes,
  Blocks,
  Tags,
  Users,
  Palette,
  LogOut,
} from 'lucide-preact';
import type { LucideIcon } from 'lucide-preact';

interface Props {
  title: string;
  user: UserContext;
}
const { title, user } = Astro.props;
const path = Astro.url.pathname;

type NavIcon = LucideIcon;

const nav: { href: string; label: string; icon: NavIcon }[] = [
  { href: '/', label: 'Tableau de bord', icon: LayoutDashboard },
  { href: '/content', label: 'Contenu', icon: FileText },
  { href: '/media', label: 'Médias', icon: Image },
  { href: '/types', label: 'Types de contenu', icon: Shapes },
  { href: '/paragraphs', label: 'Paragraphes', icon: Blocks },
  { href: '/taxonomy', label: 'Taxonomie', icon: Tags },
  ...(user.role === 'admin'
    ? [
        { href: '/users', label: 'Utilisateurs', icon: Users },
        { href: '/appearance', label: 'Apparence', icon: Palette },
      ]
    : []),
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- L'admin est full-size et n'a pas de thème front : design system
         totalement séparé (admin.css), jamais mélangé au site public.
         reset.css doit être le tout premier stylesheet chargé : c'est lui
         qui fixe l'ordre des cascade layers (reset, admin) en tête de
         fichier. Voir public/reset.css pour l'explication complète. -->
    <link rel="stylesheet" href="/reset.css" />
  </head>
  <body class="admin">
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <div class="admin-brand">CMF Edge — Admin</div>
        {nav.map(({ icon: Icon, ...item }) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
            <Icon size={16} aria-hidden={true} />
            {item.label}
          </a>
        ))}
      </aside>
      <header class="admin-topbar">
        <span class="admin-user">{user.email} · {user.role}</span>
        <form method="post" action="/api/logout" class="inline">
          <button type="submit">
            <LogOut size={15} aria-hidden={true} />
            Déconnexion
          </button>
        </form>
      </header>
      <main class="admin-main">
        <slot />
      </main>
    </div>
  </body>
</html>
