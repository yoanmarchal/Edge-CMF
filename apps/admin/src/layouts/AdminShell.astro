---
import '../styles/admin.css';
import Flash from '../components/Flash.astro';
import type { UserContext } from '@edge-cmf/shared-types';
// Icônes SSR uniquement : rendues en SVG statique côté serveur (pas de
// directive client), donc zéro JS envoyé au navigateur pour la nav.
import {
  LayoutDashboard,
  FileText,
  Image,
  Shapes,
  Blocks,
  Tags,
  Users,
  Palette,
  LogOut,
  ChevronRight,
} from 'lucide-preact';
import type { LucideIcon } from 'lucide-preact';

export interface Crumb {
  readonly label: string;
  readonly href: string;
}

interface Props {
  /**
   * Titre de l'écran — sert À LA FOIS au <title> et au <h1>. Déclaré ici et
   * nulle part ailleurs : les îlots ne rendent plus de <h1>. Comme ils sont
   * montés en `client:only`, un titre à l'intérieur laissait la page
   * entièrement blanche jusqu'au démarrage du JS.
   */
  title: string;
  user: UserContext;
  /** Pastille technique à droite du titre (nom machine, identifiant…). */
  chip?: string;
  /** Phrase d'introduction sous le titre. */
  description?: string;
  /** Fil d'Ariane — remplace les liens « retour » réinventés par écran. */
  breadcrumb?: readonly Crumb[];
}
const { title, user, chip, description, breadcrumb } = Astro.props;
const path = Astro.url.pathname;

type NavIcon = LucideIcon;

const nav: { href: string; label: string; icon: NavIcon }[] = [
  { href: '/', label: 'Tableau de bord', icon: LayoutDashboard },
  { href: '/content', label: 'Contenu', icon: FileText },
  { href: '/media', label: 'Médias', icon: Image },
  { href: '/types', label: 'Types de contenu', icon: Shapes },
  { href: '/paragraphs', label: 'Paragraphes', icon: Blocks },
  { href: '/taxonomy', label: 'Taxonomie', icon: Tags },
  ...(user.role === 'admin'
    ? [
        { href: '/users', label: 'Utilisateurs', icon: Users },
        { href: '/appearance', label: 'Apparence', icon: Palette },
      ]
    : []),
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — CMF Edge Admin</title>

    <!-- L'admin est full-size et n'a pas de thème front : design system
         totalement séparé (admin.css), jamais mélangé au site public.
         reset.css doit être le tout premier stylesheet chargé : c'est lui
         qui fixe l'ordre des cascade layers (reset, admin) en tête de
         fichier. Voir public/reset.css pour l'explication complète. -->
    <link rel="stylesheet" href="/reset.css" />
  </head>
  <body class="admin">
    <!-- Lien d'évitement : première cible de tabulation, permet d'atteindre le
         contenu sans traverser toute la navigation latérale. -->
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <div class="admin-brand">CMF Edge — Admin</div>
        {nav.map(({ icon: Icon, ...item }) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
            <Icon size={16} aria-hidden={true} />
            {item.label}
          </a>
        ))}
      </aside>
      <header class="admin-topbar">
        <span class="admin-user">{user.email} · {user.role}</span>
        <form method="post" action="/api/logout" class="inline">
          <button type="submit">
            <LogOut size={15} aria-hidden={true} />
            Déconnexion
          </button>
        </form>
      </header>
      <main class="admin-main" id="contenu">
        <Flash />

        {breadcrumb !== undefined && breadcrumb.length > 0 && (
          <nav class="page-breadcrumb" aria-label="Fil d'Ariane">
            {breadcrumb.map((crumb) => (
              <>
                <a href={crumb.href}>{crumb.label}</a>
                <ChevronRight size={13} aria-hidden={true} />
              </>
            ))}
            <span aria-current="page">{title}</span>
          </nav>
        )}

        <header class="page-head">
          <h1>
            {title}
            {chip !== undefined && <code class="muted">{chip}</code>}
          </h1>
          {description !== undefined && <p class="muted">{description}</p>}
        </header>

        <slot />
      </main>
    </div>
  </body>
</html>
