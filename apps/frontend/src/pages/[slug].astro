---
import Base from '../layouts/Base.astro';
import { contentClient } from '../lib/api';

const { slug } = Astro.params;
if (slug === undefined || !/^[a-z0-9-]+$/.test(slug)) {
  return new Response('Page non trouvée', { status: 404 });
}

const client = contentClient();
const res = await client.api.nodes[':slug'].$get({ param: { slug } });

if (!res.ok) {
  return new Response('Page non trouvée', { status: 404 });
}
const { data: node } = await res.json();
const fieldEntries = Object.entries(node.fields);
---

<Base title={node.title}>
  <article>
    <h1>{node.title}</h1>
    <p class="muted">
      Type : {node.contentType}
      {node.terms.map((t) => <span class="badge">{t.label}</span>)}
    </p>
    <div>{node.body}</div>

    {fieldEntries.length > 0 && (
      <dl>
        {fieldEntries.map(([name, value]) => (
          <>
            <dt><strong>{name}</strong></dt>
            <dd>{String(value)}</dd>
          </>
        ))}
      </dl>
    )}

    {/* Paragraphes : blocs structurés ordonnés (équivalent Drupal Paragraphs) */}
    {node.paragraphs.map((p) => (
      <section class="paragraph-item" data-paragraph-type={p.type}>
        {Object.entries(p.fields).map(([name, value]) => (
          <p>
            <span class="muted">{name} — </span>
            {String(value)}
          </p>
        ))}
      </section>
    ))}
  </article>
</Base>
