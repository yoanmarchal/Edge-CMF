---
import AdminShell from '../../../layouts/AdminShell.astro';
import Users from '../../../islands/Users';
import { getSessionUser } from '../../../lib/session';

const env = Astro.locals.runtime.env;
const session = await getSessionUser(Astro.cookies, env);
if (session === null) return Astro.redirect('/admin');
if (session.user.role !== 'admin') return Astro.redirect('/admin?error=droits');
---

<AdminShell title="Utilisateurs — CMF Edge" user={session.user}>
  <Users client:only="preact" selfId={session.user.sub} />
</AdminShell>
