---
import Admin from '../../../layouts/Admin.astro';
import FieldInput from '../../../components/FieldInput.astro';
import ParagraphsEditor from '../../../components/ParagraphsEditor.astro';
import { getSessionUser, canWrite } from '../../../lib/session';
import { contentClient, loadParagraphTypes } from '../../../lib/api';

const env = Astro.locals.runtime.env;
const session = await getSessionUser(Astro.cookies, env);
if (session === null || !canWrite(session.user)) return Astro.redirect('/admin');

const typeId = Astro.url.searchParams.get('type') ?? 'page';
const client = contentClient(env);
const typeRes = await client.api.types[':id'].$get({ param: { id: typeId } });
if (!typeRes.ok) return Astro.redirect('/admin/content?error=type-inconnu');
const { data: typeDetail } = await typeRes.json();

const vocabRes = await client.api.vocabularies.$get();
const vocabularies = vocabRes.ok ? (await vocabRes.json()).data : [];
const paragraphTypes = await loadParagraphTypes(client);
---

<Admin title={`Nouveau ${typeDetail.type.label} — CMF Edge`} user={session.user}>
  <h1>Nouveau : {typeDetail.type.label}</h1>

  <form method="post" action="/api/admin/nodes" class="stack">
    <input type="hidden" name="_action" value="create" />
    <input type="hidden" name="contentType" value={typeDetail.type.id} />

    <label for="title">Titre</label>
    <input id="title" name="title" minlength="3" maxlength="255" required />
    <label for="slug">Slug (a-z, 0-9, tirets)</label>
    <input id="slug" name="slug" pattern="[a-z0-9-]+" required />
    <label for="body">Corps</label>
    <textarea id="body" name="body" rows="8"></textarea>

    {typeDetail.fields.length > 0 && <h2>Champs personnalisés</h2>}
    {typeDetail.fields.map((def) => <FieldInput def={def} />)}

    {paragraphTypes.length > 0 && <ParagraphsEditor paragraphTypes={paragraphTypes} />}

    {vocabularies.some((v) => v.terms.length > 0) && <h2>Taxonomie</h2>}
    {vocabularies.map((v) =>
      v.terms.length === 0 ? null : (
        <fieldset>
          <legend>{v.label}</legend>
          {v.terms.map((t) => (
            <label style="display:inline-block;margin-right:1rem">
              <input type="checkbox" name="termIds" value={t.id} /> {t.label}
            </label>
          ))}
        </fieldset>
      ),
    )}

    <label><input type="checkbox" name="status" checked /> Publié</label>
    <button type="submit">Créer</button>
  </form>
</Admin>
