---
import Admin from '../../../layouts/Admin.astro';
import { getSessionUser } from '../../../lib/session';
import { contentClient } from '../../../lib/api';

const env = Astro.locals.runtime.env;
const session = await getSessionUser(Astro.cookies, env);
if (session === null) return Astro.redirect('/admin');
if (session.user.role !== 'admin') return Astro.redirect('/admin?error=droits');

const client = contentClient(env);
const typesRes = await client.api.types.$get({ query: { kind: 'paragraph' } });
const types = typesRes.ok ? (await typesRes.json()).data : [];
---

<Admin title="Types de paragraphes — CMF Edge" user={session.user}>
  <h1>Types de paragraphes</h1>
  <p class="muted">
    Composants structurés réutilisables dans tous les contenus (équivalent Paragraphs
    de Drupal). Chaque type défini ici apparaît comme bloc ajoutable dans l'éditeur.
  </p>

  <table>
    <thead><tr><th>Libellé</th><th>Nom machine</th><th>Description</th><th></th></tr></thead>
    <tbody>
      {types.map((t) => (
        <tr>
          <td><a href={`/admin/types/${t.id}`}>{t.label}</a></td>
          <td><code>{t.id}</code></td>
          <td class="muted">{t.description}</td>
          <td><a href={`/admin/types/${t.id}`}>Gérer les champs →</a></td>
        </tr>
      ))}
    </tbody>
  </table>

  <details>
    <summary>Nouveau type de paragraphe</summary>
    <form method="post" action="/api/admin/types" class="stack">
      <input type="hidden" name="_action" value="create-type" />
      <input type="hidden" name="kind" value="paragraph" />
      <input type="hidden" name="back" value="/admin/paragraphs" />
      <label for="pid">Nom machine (a-z, 0-9, _)</label>
      <input id="pid" name="id" pattern="[a-z][a-z0-9_]*" maxlength="64" required />
      <label for="plabel">Libellé</label>
      <input id="plabel" name="label" maxlength="255" required />
      <label for="pdesc">Description</label>
      <input id="pdesc" name="description" maxlength="1024" />
      <button type="submit">Créer</button>
    </form>
  </details>
</Admin>
