---
import Base from '../../layouts/Base.astro';
import Admin from '../../layouts/Admin.astro';
import { getSessionUser } from '../../lib/session';
import { contentClient } from '../../lib/api';

const env = Astro.locals.runtime.env;
const session = await getSessionUser(Astro.cookies, env);
const error = Astro.url.searchParams.get('error');

let stats: { nodes: number; types: number } | null = null;
if (session !== null) {
  const client = contentClient(env);
  const [nodesRes, typesRes] = await Promise.all([
    client.api.nodes.$get({ query: { all: '1', limit: '100' } }),
    client.api.types.$get({ query: {} }),
  ]);
  stats = {
    nodes: nodesRes.ok ? (await nodesRes.json()).data.length : 0,
    types: typesRes.ok ? (await typesRes.json()).data.length : 0,
  };
}
---

{session === null ? (
  <Base title="Connexion — CMF Edge">
    <h1>Administration</h1>
    {error !== null && <p class="notice error">Erreur : {error}</p>}
    <form method="post" action="/api/login" class="stack">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required />
      <label for="password">Mot de passe</label>
      <input id="password" name="password" type="password" minlength="8" required />
      <button type="submit">Se connecter</button>
    </form>
  </Base>
) : (
  <Admin title="Tableau de bord — CMF Edge" user={session.user}>
    <h1>Tableau de bord</h1>
    <ul>
      <li><a href="/admin/content">{stats?.nodes ?? 0} contenu(s)</a></li>
      <li><a href="/admin/types">{stats?.types ?? 0} type(s) de contenu</a></li>
    </ul>
    <p class="muted">
      API headless publique : déployer le gateway-worker puis consommer
      <code>/v1/nodes</code> avec une clé API (header <code>x-api-key</code>).
    </p>
  </Admin>
)}
