---
import Base from '../../layouts/Base.astro';
import AdminShell from '../../layouts/AdminShell.astro';
import Dashboard from '../../islands/Dashboard';
import { getSessionUser } from '../../lib/session';

const env = Astro.locals.runtime.env;
const session = await getSessionUser(Astro.cookies, env);
const error = Astro.url.searchParams.get('error');
---

{session === null ? (
  <Base title="Connexion — CMF Edge">
    <h1>Administration</h1>
    {error !== null && <p class="notice error">Erreur : {error}</p>}
    <form method="post" action="/api/login" class="stack">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required />
      <label for="password">Mot de passe</label>
      <input id="password" name="password" type="password" minlength="8" required />
      <button type="submit">Se connecter</button>
    </form>
  </Base>
) : (
  <AdminShell title="Tableau de bord — CMF Edge" user={session.user}>
    <h1>Tableau de bord</h1>
    <Dashboard client:only="preact" />
  </AdminShell>
)}
