---
/**
 * Rendu d'une valeur de champ de la Field API, agnostique du bundle :
 * - tableau (champ à cardinalité multiple) → itération sur chaque item ;
 * - chemin média `/media/…` → <img> si image, lien de téléchargement sinon,
 *   avec URL VERSIONNÉE (`?v=<timestamp d'upload>`, équivalent itok de
 *   Drupal) résolue au rendu SSR via le media-worker : un remplacement de
 *   fichier change l'URL, donc les caches navigateur/edge détectent la
 *   modification immédiatement — et les URLs versionnées peuvent être
 *   servies en cache immuable ;
 * - tout le reste → texte brut.
 */
// La résolution des versions vit dans `lib/media-versions.ts` : mémoïsée à
// l'échelle de l'isolat et dédoublonnée, au lieu d'une sous-requête par
// valeur affichée (constat P1-1 de l'audit).
import { versionedMediaUrl } from '../lib/media-versions';

interface Props {
  value: unknown;
}
const { value } = Astro.props;

const IMAGE_RE = /\.(jpe?g|png|webp|avif|gif|svg)$/i;
const isMedia = (v: unknown): v is string => typeof v === 'string' && v.startsWith('/media/');
const items: unknown[] = Array.isArray(value) ? value : [value];

type Rendered =
  | { kind: 'image'; href: string }
  | { kind: 'file'; href: string }
  | { kind: 'text'; text: string };

const rendered: Rendered[] = await Promise.all(
  items.map(async (item): Promise<Rendered> => {
    if (isMedia(item)) {
      const href = await versionedMediaUrl(item);
      return IMAGE_RE.test(item) ? { kind: 'image', href } : { kind: 'file', href };
    }
    return { kind: 'text', text: String(item) };
  }),
);
---

{
  rendered.map((r) =>
    r.kind === 'image' ? (
      <img class="field-media" src={r.href} alt="" loading="lazy" />
    ) : r.kind === 'file' ? (
      <a class="field-media-link" href={r.href}>
        Télécharger le fichier
      </a>
    ) : (
      <span class="field-value">{r.text}</span>
    ),
  )
}
