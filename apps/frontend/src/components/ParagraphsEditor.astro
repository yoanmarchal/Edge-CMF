---
import FieldInput from './FieldInput.astro';
import type { FieldDef } from '@edge-cmf/shared-types';

export interface ParagraphTypeDef {
  id: string;
  label: string;
  fields: FieldDef[];
}
export interface ExistingParagraph {
  type: string;
  fields: Record<string, unknown>;
}

interface Props {
  paragraphTypes: ParagraphTypeDef[];
  existing?: ExistingParagraph[];
}
const { paragraphTypes, existing = [] } = Astro.props;
const typeById = new Map(paragraphTypes.map((t) => [t.id, t]));
---

<h2>Paragraphes</h2>
<p class="muted">Compose le contenu par blocs structurés, réordonnables à la création.</p>

<div id="paragraphs-container">
  {existing.map((p, i) => {
    const t = typeById.get(p.type);
    return t === undefined ? null : (
      <div class="paragraph-item">
        <p>
          <strong>{t.label}</strong>
          <button type="button" class="danger" onclick="removeParagraph(this)">Retirer</button>
        </p>
        <input type="hidden" name={`p_${i}_type`} value={p.type} />
        {t.fields.map((def) => (
          <FieldInput def={def} value={p.fields[def.name]} prefix={`p_${i}_`} />
        ))}
      </div>
    );
  })}
</div>

<p>
  Ajouter :
  {paragraphTypes.map((t) => (
    <button type="button" class="badge" onclick={`addParagraph('${t.id}')`}>+ {t.label}</button>
  ))}
</p>

{paragraphTypes.map((t) => (
  <template data-ptype={t.id}>
    <div class="paragraph-item">
      <p>
        <strong>{t.label}</strong>
        <button type="button" class="danger" onclick="removeParagraph(this)">Retirer</button>
      </p>
      <input type="hidden" name={`p___IDX___type`} value={t.id} />
      {t.fields.map((def) => <FieldInput def={def} prefix={`p___IDX___`} />)}
    </div>
  </template>
))}

<script is:inline define:vars={{ initialCount: existing.length }}>
  window.__pIdx = initialCount;
  window.addParagraph = function (type) {
    const tpl = document.querySelector(`template[data-ptype="${type}"]`);
    if (!tpl) return;
    const wrapper = document.createElement('div');
    wrapper.innerHTML = tpl.innerHTML.replaceAll('__IDX__', String(window.__pIdx++));
    const item = wrapper.firstElementChild;
    if (item) document.getElementById('paragraphs-container').appendChild(item);
  };
  window.removeParagraph = function (btn) {
    const item = btn.closest('.paragraph-item');
    if (item) item.remove();
  };
</script>
