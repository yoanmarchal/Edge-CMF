---
import '../styles/reset.css';
import { getActiveTheme } from '../lib/api';
import { DEFAULT_THEME_ID } from '../lib/themes';

interface Props {
  title: string;
}
const { title } = Astro.props;

// SSR : le front garde le rendu serveur (SEO), contrairement à l'admin qui
// n'en a plus besoin (voir AdminShell.astro + src/islands/). Le thème actif
// est résolu ici pour injecter les bonnes feuilles de style natives.
const activeTheme = await getActiveTheme(Astro.locals.runtime.env);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Ordre des layers fixé explicitement : theme-override gagne toujours
         sur theme, quel que soit l'ordre des <link> ci-dessous. -->
    <style>
      @layer reset, theme, theme-override;
    </style>
    <link rel="stylesheet" href={`/themes/${DEFAULT_THEME_ID}/theme.css`} />
    {activeTheme !== DEFAULT_THEME_ID && (
      <link rel="stylesheet" href={`/themes/${activeTheme}/theme.css`} />
    )}
  </head>
  <body class="site">
    <div class="site-container">
      <header class="site-header">
        <a href="/"><strong>CMF Edge</strong></a>
        <nav>
          <a href="/">Accueil</a>
          <a href="/admin">Admin</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
